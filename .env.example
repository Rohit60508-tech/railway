# ==============================================================================
# Indian Railways AI Maintenance Platform — Environment Template (.env.example)
# Copy this file to '.env' and populate with your production or local secrets.
# ==============================================================================

# 1. System Database & Caching
DATABASE_URL="postgresql://user:password@localhost:5432/ir_maintenance"
REDIS_URL="redis://localhost:6379/0"

# 2. RapidAPI / IRCTC Live Train Movement & Location Tracking
RAPIDAPI_KEY="your_rapidapi_key_here"
RAPIDAPI_HOST="indian-railway-irctc.p.rapidapi.com"
RAPIDAPI_APP="default-application"
INDIAN_RAIL_API_KEY="your_indian_railways_api_key_here"

# 3. External Weather & GIS Integrations
OPENWEATHER_API_KEY="your_openweather_api_key_here"
MAPBOX_ACCESS_TOKEN="pk.your_mapbox_public_access_token_here"

# 4. Core Microservice Ports & Auth
PORT=5000
API_PORT=5001
HOST=0.0.0.0
AI_SERVICE_URL="http://127.0.0.1:5001"
AI_API_KEYS="ir-ai-key-2026,ir-officer-token,admin-secret-key,test-token"
NODE_ENV=development

# 5. Supabase PostgreSQL Cloud & Cryptographic Immutable Audit Ledger
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key_here"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"
